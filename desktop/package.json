{
  "name": "q-nexus-quantum-jarvis-desktop",
  "version": "1.0.0",
  "description": "Q-NEXUS: Quantum Tachyon Jarvis OS for PC",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.wasi.quantumjarvis",
    "productName": "Quantum Jarvis OS",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist-electron"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
